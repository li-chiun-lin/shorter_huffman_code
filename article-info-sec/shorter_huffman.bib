keywords = {Reversible data hiding,cipher-feedback secret sharing,encrypted image,multiple data hiders},
month = {aug},
number = {8},
pages = {4968--4982},
publisher = {Institute of Electrical and Electronics Engineers Inc.},
title = {{Reversible Data Hiding in Encrypted Images Using Cipher-Feedback Secret Sharing}},
volume = {32},
year = {2022}
}
@article{Zhang2008,
abstract = {Full-text indices are data structures that can be used to find any substring of a given string. Many full-text indices require space larger than the original string. In this paper, we introduce the canonical Huffman code to the wavelet tree of a string T[1 ⋯ n]. Compared with Huffman code based wavelet tree, the memory space used to represent the shape of wavelet tree is not needed. In case of large alphabet, this part of memory is not negligible. The operations of wavelet tree are also simpler and more efficient due to the canonical Huffman code. Based on the resulting structure, the multi-key rank and select functions can be performed using at most nH0 + |∑|(lglgn + lgn - lg|∑|) + O (nH0) bits and in O(H0) time for average cases, where H0 is the zeroth order empirical entropy of T. In the end, we present an efficient construction algorithm for this index, which is on-line and linear.},
author = {Zhang, Yi and Pei, Zhili and Yang, Jinhui and Liang, Yanchun},
doi = {10.1016/j.pnsc.2007.11.001},
file = {:C\:/Users/ttn/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Zhang et al. - 2008 - Canonical Huffman code based full-text index.pdf:pdf},
issn = {10020071},
journal = {Progress in Natural Science},
keywords = {Canonical Huffman code,Full-text index,Suffix automaton},
number = {3},
pages = {325--330},
publisher = {Science Press},
title = {{Canonical Huffman code based full-text index}},
volume = {18},
year = {2008}
}
