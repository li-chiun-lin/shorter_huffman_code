isbn = {9783642241772},
issn = {03029743},
pages = {59--70},
publisher = {Springer, Berlin, Heidelberg},
title = {{"Break our steganographic system": The ins and outs of organizing BOSS}},
url = {https://link.springer.com/chapter/10.1007/978-3-642-24178-9{\_}5},
volume = {6958 LNCS},
year = {2011}
